# Netlify: Project configuration > Environment variables, scope Functions.
# Never use VITE_ or NEXT_PUBLIC_ prefixes for these secrets.
# Supabase > Connect > Transaction pooler (port 6543). URL-encode the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_SERVICE_ROLE_OR_SECRET_KEY
SUPABASE_STORAGE_BUCKET=barovia-media
# If required: Supabase database CA certificate (PEM), from Database settings.
# DATABASE_CA_CERT=

# Preview content writes are disabled by default. Enable ONLY with a separate test database and bucket.
# Scope this override to the preview context; never point it at the live campaign.
# BAROVIA_ALLOW_PREVIEW_WRITES=true
