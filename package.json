{
  "name": "barovia-campaign",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npx netlify dev",
    "build": "npm run build:netlify",
    "build:netlify": "tsc --noEmit -p tsconfig.netlify.json && vite build --config vite.netlify.config.ts",
    "test": "npm run test:postgres && npm run test:unit",
    "test:postgres": "node scripts/test-postgres.mjs",
    "transfer:import": "node --env-file=.env.netlify.local scripts/import-backups.mjs",
    "transfer:guided": "node scripts/import-guided.mjs",
    "test:unit": "node --test tests/transfer.test.mjs tests/routes.test.mjs tests/combat.test.mjs tests/deploy.test.mjs",
    "preview:demo": "node scripts/preview-demo.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@supabase/supabase-js": "2.116.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "postgres": "3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "esbuild": "0.28.0"
  },
  "type": "module"
}
